[Unit]
Description=CrossHare photo and video sync service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/crosshare --no-tray
Restart=on-failure
RestartSec=5s
Environment=CROSSHARE_TRANSCRIPT_WS=ws://127.0.0.1:8013/v1/audio/realtime

# Optional Wayland text injection. Enable in a user drop-in when this machine
# should inject final speech transcripts into the focused text field:
#
#   systemctl --user edit crosshare
#
# Then add:
#
#   [Service]
#   Environment=CROSSHARE_TEXT_INJECT=1
#   Environment=CROSSHARE_TEXT_INJECT_MODE=portal-unicode
#   Environment=CROSSHARE_TEXT_INJECT_PREAUTHORIZE=1

[Install]
WantedBy=default.target
